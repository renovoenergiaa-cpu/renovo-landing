# Local: copie para .env. Na Vercel: Settings > Environment Variables.
RENOVO_WHATSAPP=5515991699585
# Em produção: banco libSQL/Turso remoto (não usar arquivo local na Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local, sem Turso: SQLite neste arquivo (fora de src/public).
LOCAL_DB_PATH=.data/renovo.sqlite
# Mínimo 12 caracteres, senha exclusiva da administração.
ADMIN_PASSWORD=
# Mínimo 32 caracteres aleatórios. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Opcional. Configure para o domínio final; deixe vazio nos previews Vercel.
APP_URL=
# Integração opcional, sem necessidade para PDF/WhatsApp por link.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_API_TOKEN=
# Preparação para tracking, sem envio ao Meta por padrão.
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
